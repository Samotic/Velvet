{
  "name": "velvet-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Velvet API — auth, catalog, social (Express + MongoDB)",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "verify": "tsx scripts/verify-auth.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "verify:follow": "tsx scripts/verify-follow-requests.ts",
    "verify:ai": "tsx scripts/verify-ai.ts",
    "verify:account": "tsx scripts/verifyAccount.ts",
    "verify:messages": "tsx scripts/verify-message-edit-delete.ts",
    "verify:privacy": "tsx scripts/verify-privacy.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.17.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "resend": "^6.18.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
