# ── Velvet backend environment ────────────────────────────────────────────
# Copy to backend/.env and fill in. Never commit the real .env.
#
# Only JWT_SECRET and MONGODB_URI are required. Every third-party integration
# below is optional: the server boots without it and the routes that need it
# answer 503 with a readable message. The boot log prints which are live.

# ── required ──────────────────────────────────────────────────────────────

# Secret used to sign JWTs. Generate a long random string for production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=velvet_super_secret_jwt_key_change_this_in_production

# MongoDB Atlas connection string (Database → Connect → Drivers).
# Include the db name, e.g. .../velvet?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/velvet?retryWrites=true&w=majority

# Where the Next.js frontend runs — the CORS allow-list and the origin
# Socket.io accepts.
#
# ENFORCED: the server refuses to boot in production without it. The localhost
# fallback below is right for a laptop and catastrophic on a host — the API
# would start healthily, pass its healthcheck, and reject every request the
# browser makes. Value: your deployed frontend origin, no trailing slash.
# See DEPLOY.md.
FRONTEND_URL=http://localhost:3000

# Port the API listens on. The frontend's NEXT_PUBLIC_API_URL must match.
PORT=4000

# ── catalogue: films and series ───────────────────────────────────────────
# https://www.themoviedb.org/settings/api — provide EITHER. The v4 read token
# is preferred; if both are set, the token wins.

# v4 "API Read Access Token" (a long eyJ... JWT)
TMDB_READ_TOKEN=

# v3 "API Key" (a 32-char hex string)
TMDB_API_KEY=

# ── catalogue: games ──────────────────────────────────────────────────────
# IGDB authenticates with Twitch app credentials:
# https://dev.twitch.tv/console/apps — without these, Games is empty and the
# rest of the catalogue is unaffected.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ── AI advisor ────────────────────────────────────────────────────────────
# Which provider backs the advisor: 'gemini' (default) or 'anthropic'.
# Both live behind the AIProvider interface in src/lib/ai.
AI_PROVIDER=gemini

# https://aistudio.google.com/apikey — without this the advisor answers 503.
# Server-side only. This must never reach the browser bundle.
GEMINI_API_KEY=

# Pinned, never a `-latest` alias — an alias moves the model under a running
# deployment and the first sign is changed answers.
# GEMINI_MODEL=gemini-3.6-flash

# ── retained while the Gemini migration is verified ───────────────────────
# https://console.anthropic.com — only read when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Overridable so the model can move without a code change.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Daily advisor allowance per account. Velvet has no paid tier, so this cap is
# the only bound on what the model costs you. Accounts with isPro set by hand
# skip it.
# AI_FREE_DAILY_MESSAGES=25

# ── uploads: profile photos, message photos and voice notes ───────────────
# https://cloudinary.com/console — without these, uploads are refused politely
# and everything else still works: messaging stays open, text-only, and the
# photo and microphone buttons answer 503 with a readable message.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── sign in with Google ───────────────────────────────────────────────────
# console.cloud.google.com → new project → APIs & Services → Credentials →
# Create OAuth client ID → Web application.
#
# The Authorised redirect URI must be THIS API, not the frontend:
#   http://localhost:4000/api/auth/google/callback
#
# (OAuth is handled by Express so the client secret never reaches the browser.
#  In production set API_URL to the API's public origin and register that
#  callback too.) Without these the button is hidden and the routes 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The exact Authorised redirect URI registered in the console. Google compares
# it byte for byte. Both callback paths below are served by the API, so set this
# to whichever one you registered rather than editing Google:
#   http://localhost:4000/api/auth/google/callback   (this project's own)
#   http://localhost:4000/api/auth/callback/google   (passport / NextAuth style)
# Leave blank to derive the first from API_URL.
GOOGLE_CALLBACK_URL=

# ── email: SMTP ───────────────────────────────────────────────────────────
# How Velvet sends mail: verification links, password resets, the welcome
# email, login alerts, follower and message notifications.
#
# BACKEND ONLY. These values must never appear in the frontend or a mobile
# app, in the database, in an API response or in a log.
#
# Leave them empty and the API still boots. It logs
#   "SMTP is not configured. Email functionality is disabled."
# and every send becomes a logged no-op. Fill them in and restart the API.
#
# SMTP_HOST, SMTP_USER, SMTP_PASS and EMAIL_FROM_ADDRESS are needed together.
# DEPLOY.md lists where each value comes from for the common providers.

# The provider's SMTP server, as a bare hostname: smtp.example.com
SMTP_HOST=

# 587 + SMTP_SECURE=false  → STARTTLS, required before login. The usual choice.
# 465 + SMTP_SECURE=true   → TLS from the first byte.
SMTP_PORT=587
SMTP_SECURE=false

# The SMTP login, and its password / app password / SMTP key.
SMTP_USER=
SMTP_PASS=

# Who emails are from — read by BOTH transports, SMTP and Resend.
#
# EMAIL_FROM_ADDRESS holds the bare address only, never "Name <address>"; the
# display name is EMAIL_FROM_NAME, which is optional and defaults to Velvet.
# Together they are sent as: Velvet <no-reply@mail.velvetapp.app>
#
# The address must be one the provider lets you send as: a domain verified in
# Resend (Domains → Add domain), or an address the SMTP account may use.
EMAIL_FROM_NAME=Velvet
EMAIL_FROM_ADDRESS=no-reply@mail.velvetapp.app

# The frontend origin that links inside emails point at, no trailing slash.
# Leave empty to use FRONTEND_URL.
APP_URL=

# ── email: Resend (fallback) ──────────────────────────────────────────────
# Used only while SMTP above is not fully configured. resend.com → API Keys.
# Login alerts never go through it — they wait for SMTP.
RESEND_API_KEY=

# Older single-string override for the Resend sender, kept for deployments that
# still set it. It is only read when EMAIL_FROM_ADDRESS above is empty or not a
# bare address. With neither, Resend falls back to onboarding@resend.dev, which
# delivers only to the address that owns the Resend account.
# EMAIL_FROM=Velvet <noreply@yourdomain.com>

# This API's own public origin — used to build the Google callback URL.
#
# ENFORCED, conditionally: the server refuses to boot in production when Google
# sign-in is configured and neither this nor GOOGLE_CALLBACK_URL is set. That is
# its only consumer, so a deployment without Google credentials never reads it
# and is not asked for it. Value: this service's own public URL, no trailing
# slash. See DEPLOY.md.
# API_URL=http://localhost:4000

# ── deployment: Railway (root directory /backend) ─────────────────────────
#
# One checklist for the dashboard. Everything above is still required; this
# section is only what CHANGES or is easy to miss when it stops being local.
#
#   MUST be set, and differ from the values above:
#     JWT_SECRET        a real random string, not the placeholder. Changing it
#                       later signs every existing session out.
#     MONGODB_URI       the production Atlas cluster, not your dev one.
#     FRONTEND_URL      https://your-app.vercel.app  — no trailing slash. This
#                       is the CORS allow-list and the Socket.io origin; get it
#                       wrong and every API call from the browser is blocked.
#     API_URL           https://your-api.up.railway.app — the API's own public
#                       origin, used to build the Google callback.
#
#   MUST NOT be set:
#     PORT              Railway injects it. Setting it yourself pins the server
#                       to a port the platform is not routing to, and the
#                       healthcheck then fails on a process that is running fine.
#     MEDIA_DESTROY_DRYRUN
#                       Only ever 'true' for inspecting what a delete WOULD
#                       remove. Left on in production, retracted photos and
#                       voice notes are never actually deleted from Cloudinary.
#
#   Set automatically, no action needed:
#     NODE_ENV          the Dockerfile sets it to 'production'.
#
#   Leave unset unless you know otherwise:
#     SUPPORTS_TRANSACTIONS
#                       Defaults to true, which is correct for Atlas — it is a
#                       replica set. Only set it to 'false' against a
#                       standalone mongod, where every transaction throws.
#
#   Healthcheck path:   /health   (200, and deliberately does not touch Mongo)
#
#   Google OAuth, after the API has a public URL:
#     Add https://your-api.up.railway.app/api/auth/google/callback to the
#     Authorised redirect URIs in the Google console, and set GOOGLE_CALLBACK_URL
#     to that exact string. Google compares it byte for byte — a trailing slash
#     or http-vs-https is a failed sign-in, not a warning.
#
#   HTTPS is not optional. Voice notes and the advisor's microphone use
#   getUserMedia, which browsers refuse outside a secure context. On plain http
#   the microphone button hides itself and the feature silently does not exist.
#
# ── deployment: Vercel (repo root) ────────────────────────────────────────
#
#   The frontend needs exactly one variable, in the Vercel dashboard:
#     NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
#
#   It is baked in at BUILD time, not read at runtime — changing it means
#   redeploying, not restarting. See the root .env.example.
#
#   Deploy order: the API first, so its public URL exists to paste into
#   NEXT_PUBLIC_API_URL, then the frontend, then come back and set FRONTEND_URL
#   on Railway to the Vercel URL.
