# ---------------------------------------------------------------------------
# Velvet — frontend environment
#
# The frontend holds no third-party secrets. Every catalogue, AI, upload and
# payment credential lives in backend/.env, because the browser must never see
# them — see backend/.env.example for that list.
#
# The only value the browser needs is where to find the API.
# ---------------------------------------------------------------------------

# Base URL of the Velvet API. Must match the backend's PORT.
# NEXT_PUBLIC_ is deliberate here: the browser makes these calls directly, and
# a public URL is not a secret. It is also the Socket.io origin for messaging.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# The frontend's own origin is NOT configured here, and that is deliberate.
#
# It is fixed at http://localhost:3000 by `npm run dev`, which refuses to start
# on any other port (scripts/dev.mjs). Nothing in the frontend builds an
# absolute URL to itself — links are relative, and the backend owns the one
# place a full frontend URL is needed (FRONTEND_URL, for verification emails
# and CORS). A second source of truth here would only be able to disagree.
#
# There is no NEXTAUTH_URL / AUTH_URL either: Velvet does not use NextAuth.
# OAuth runs in Express so the client secret never reaches the browser — see
# backend/.env.example.
# ---------------------------------------------------------------------------
